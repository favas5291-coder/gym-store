{
  "appId": "com.gymdrobe.app",
  "appName": "GymDrobe",
  "webDir": "dist-android",
  "includePlugins": [
    "@capacitor/app",
    "@capacitor/browser",
    "@capacitor/keyboard",
    "@capacitor/share",
    "@capacitor/splash-screen",
    "@capgo/capacitor-social-login",
    "@capacitor/camera"
  ],
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0F3D3A"
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      },
      "logLevel": 1
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "backgroundColor": "#0F3D3A",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "contain",
      "style": "LIGHT"
    }
  },
  "ios": {
    "backgroundColor": "#0F3D3A"
  }
}
