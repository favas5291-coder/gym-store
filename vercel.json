{
  "routes": [
    {
      "src": "^/gymdrobe-share-v1\\.png$",
      "headers": {
        "Location": "/gymdrobe-share-v2.png"
      },
      "status": 308
    },
    {
      "src": "^/favicon\\.jpeg$",
      "headers": {
        "Location": "/favicon.ico?v=3"
      },
      "status": 308
    },
    {
      "src": "^/favicon-64-v1\\.png$",
      "headers": {
        "Location": "/favicon-48x48.png?v=3"
      },
      "status": 308
    },
    {
      "src": "/(product/[^/]+|collections/[^/]+|shop|offers|help)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "/(?:product/[^/]+|collections/[^/]+|shop|offers|help)$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(?:account|cart|wishlist|checkout|login|orders|addresses|saved|compare|notifications|admin|supplier|dev)(?:/.*)?$",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/(?:sw\\.js|offline\\.(?:html|js)|site\\.webmanifest)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/media/campaign/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$))[^.]*",
      "dest": "/index.html"
    }
  ]
}
