{
  "routes": [
    {
      "src": "^/index\\.html$",
      "headers": { "Location": "/" },
      "status": 308
    },
    {
      "src": "^/gymdrobe-share-v1\\.png$",
      "headers": {
        "Location": "/gymdrobe-share-v2.png"
      },
      "status": 308
    },
    {
      "src": "^/favicon\\.jpeg$",
      "headers": {
        "Location": "/favicon.ico?v=4"
      },
      "status": 308
    },
    {
      "src": "^/favicon-64-v1\\.png$",
      "headers": {
        "Location": "/favicon-48x48.png?v=4"
      },
      "status": 308
    },
    {
      "src": "/(product/[^/]+|collections/[^/]+|shop|offers|help|install)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "/(?:product/[^/]+|collections/[^/]+|shop|offers|help|install)$",
      "headers": {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "availability" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "brand" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "category" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "collection" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "color" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "department" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "discount" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "gender" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "literal" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "maxPrice" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "minPrice" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "page" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "rating" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "search" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "size" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "sort" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:shop|collections/[^/]+)/?$",
      "has": [{ "type": "query", "key": "subcategory" }],
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "^/(?:storefront-shell\\.html|(?:account|cart|wishlist|checkout|login|orders|addresses|saved|compare|notifications|admin|supplier|dev|order-success|signup|forgot-password|reset-password|search|categories|kits)(?:/.*)?)$",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/(?:sw\\.js|offline\\.(?:html|js)|site\\.webmanifest)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/media/campaign/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:product/[^/]+|collections/(?:compression-t-shirts|gym-joggers|gym-bags))/?$",
      "dest": "/storefront-shell.html"
    },
    {
      "src": "^/(?:account|cart|wishlist|checkout|login|orders|addresses|saved|compare|notifications|admin|supplier|dev|order-success|signup|forgot-password|reset-password|search|categories|kits)(?:/[^.]*)?$",
      "dest": "/storefront-shell.html"
    },
    {
      "src": "^/(?!api(?:/|$)|[.])[^.]*$",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
